APP_NAME=Grillr Interview Coach API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./grillr.db
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=change-me-in-development
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
OPENAI_API_KEY=
RIME_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
STT_PROVIDER=whisper
MAX_FOLLOW_UPS_PER_QUESTION=1
AUTH_REQUIRED=false
SQL_ECHO=false
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
INTERVIEW_CREATION_RATE_LIMIT=5
INTERVIEW_CREATION_RATE_WINDOW_SECONDS=60
ANSWER_RATE_LIMIT=20
ANSWER_RATE_WINDOW_SECONDS=60
WHISPER_MODEL_SIZE=base
STT_TIMEOUT_SECONDS=60
USER_RATE_LIMIT=100
USER_RATE_WINDOW_SECONDS=60
